# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env asli (berisi kredensial).

PORT=5000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=elkon_db
JWT_SECRET=ganti-dengan-string-acak-panjang

# CORS_ORIGINS opsional (koma): domain frontend yang boleh memanggil API.
# Default: http://localhost:5173,http://127.0.0.1:5173,http://eikon.test,http://eikon.test:5173,https://www.eliteikon.com,https://elkon.whitelabel.co.id
# CORS_ORIGINS=https://www.eliteikon.com

# Konfigurasi payment gateway (Tripay) TIDAK di .env.
# Atur dari dashboard admin: login > tab Payment Gateway (tersimpan di database).
