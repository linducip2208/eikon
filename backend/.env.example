# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env asli (berisi kredensial).

PORT=5000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=elkon_db
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- iPaymu Payment Gateway ---
# Ambil VA & API Key dari dashboard iPaymu:
#   Sandbox    : https://sandbox.ipaymu.com/integration
#   Production : https://my.ipaymu.com/integration
IPAYMU_ENV=sandbox
IPAYMU_VA=
IPAYMU_API_KEY=
# URL publik aplikasi (untuk returnUrl & cancelUrl pembayaran)
APP_URL=http://eikon.test
# URL publik callback webhook (opsional jika APP_URL sudah domain publik)
IPAYMU_NOTIFY_URL=
