# Konfigurasi KHUSUS `npm run dev` (hot-reload di http://localhost:5173).
# File ini HANYA dibaca saat mode development — `npm run build` mengabaikannya,
# sehingga hasil build memakai deteksi runtime di src/utils/api.js
# (lokal -> "/api" via proxy Apache, production -> API production).
VITE_API_URL=http://localhost:5000/api
