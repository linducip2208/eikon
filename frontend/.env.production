# File ini SENGAJA tidak menyetel VITE_API_URL - alamat API ditentukan otomatis
# saat runtime oleh frontend/src/utils/api.js:
#   - eikon.test / localhost / 127.0.0.1   -> "/api" (diproxy Apache lokal ke Express :5000)
#   - domain lain (production)             -> https://api.kingcreativestudio.my.id/elkon/api
#
# Hasil `npm run build` bersifat "universal": satu folder dist dipakai di lokal
# maupun production, dan ikut di-commit ke git (deployment pull-only - lihat README).
#
# JANGAN set VITE_API_URL di file ini kecuali ingin memaksa alamat API tertentu
# (override dev bisa lewat frontend/.env.development.local).
