# File ini SENGAJA tidak menyetel VITE_API_URL - alamat API selalu relatif "/api"
# (satu domain, ditentukan saat runtime oleh frontend/src/utils/api.js):
#   - npm run dev  -> VITE_API_URL dari .env.development (http://localhost:5000/api)
#   - eikon.test / production satu domain -> "/api" (diproxy ke Express :5000)
#
# Hasil `npm run build` bersifat "universal": satu folder dist dipakai di semua
# environment, dan ikut di-commit ke git (deployment pull-only - lihat README).
#
# JANGAN set VITE_API_URL di file ini kecuali ingin memaksa alamat API tertentu
# (override dev bisa lewat frontend/.env.development.local).
